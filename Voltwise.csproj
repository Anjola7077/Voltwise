<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <AssemblyName>Voltwise</AssemblyName>
    <RootNamespace>Voltwise</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationId>com.companyname.voltwise</ApplicationId>
    <ApplicationTitle>Voltwise</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <MauiXaml Include="App.xaml" />
    <MauiXaml Include="AppShell.xaml" />
    <MauiXaml Include="MainPage.xaml" />
    <MauiXaml Include="Resources/Styles/Colors.xaml" />
    <MauiXaml Include="Resources/Styles/Styles.xaml" />
    <PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
    <MauiSplashScreen Include="Resources/Apk/splash.jpg" />
    <MauiIcon Include="Resources/Apk/icon.jpg" />
  </ItemGroup>
  <ItemGroup>
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
  </ItemGroup>
</Project>