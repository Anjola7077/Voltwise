<?xml version="1.0" encoding="utf-8" ?>

<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Voltwise.App">

    <Application.Resources>

        <ResourceDictionary>

            <!-- Voltwise brand -->

            <Color x:Key="VoltGreen">#9BE564</Color>
            <Color x:Key="VoltGreenDark">#315D29</Color>

            <Color x:Key="LightBackground">#F4F6F8</Color>
            <Color x:Key="LightSurface">#FFFFFF</Color>
            <Color x:Key="LightSurfaceAlt">#EAEFF2</Color>
            <Color x:Key="LightText">#20262D</Color>
            <Color x:Key="LightMuted">#66717E</Color>
            <Color x:Key="LightBorder">#E0E5E9</Color>

            <Color x:Key="DarkBackground">#111418</Color>
            <Color x:Key="DarkSurface">#1B2026</Color>
            <Color x:Key="DarkSurfaceAlt">#252C34</Color>
            <Color x:Key="DarkText">#F3F5F7</Color>
            <Color x:Key="DarkMuted">#A2ACB8</Color>
            <Color x:Key="DarkBorder">#343B44</Color>

            <Color x:Key="WarningAmber">#F2B84B</Color>
            <Color x:Key="DangerRed">#E45B5B</Color>

            <!-- Typography -->

            <Style TargetType="Label">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource LightText},
                                                Dark={StaticResource DarkText}}" />
                <Setter Property="FontFamily"
                        Value="OpenSansRegular" />
            </Style>

            <Style x:Key="PageTitle"
                   TargetType="Label">
                <Setter Property="FontSize" Value="29" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="-0.6" />
            </Style>

            <Style x:Key="SectionTitle"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="SupportingText"
                   TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource LightMuted},
                                                Dark={StaticResource DarkMuted}}" />
            </Style>

            <!-- Primary action -->

            <Style x:Key="PrimaryButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource VoltGreen}" />
                <Setter Property="TextColor" Value="#172116" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="18,13" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <!-- Card styling -->

            <Style x:Key="DashboardCard"
                   TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource LightSurface},
                                                Dark={StaticResource DarkSurface}}" />
                <Setter Property="Stroke"
                        Value="{AppThemeBinding Light={StaticResource LightBorder},
                                                Dark={StaticResource DarkBorder}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="24" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="18" />
            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>